rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todos pueden VER los productos; solo el dueño puede crearlos, editarlos o borrarlos.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "PEGA_AQUI_TU_UID";
    }
    match /{document=**} { allow read, write: if false; }
  }
}
